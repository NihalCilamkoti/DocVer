APP_NAME=DocVer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.docver.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=docver_db
DB_USERNAME=docver_user
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.docver.example.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=docver_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="no-reply@docver.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.docver.example.com,docver.example.com
FRONTEND_URL=https://app.docver.example.com

HORIZON_PREFIX=docver_horizon:

# AI Providers Orchestration (Three-Provider Integration)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ORDER=gemini,groq,openrouter
AI_MAX_RETRIES=2
AI_ENABLE_AUTOMATIC_FAILOVER=true
AI_DAILY_QUOTA_SAFETY_MARGIN=5

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-1.5-pro
GEMINI_TIMEOUT_SECONDS=60
GEMINI_ENABLED=true

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=45
GROQ_ENABLED=true

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REASONING_MODEL=openai/gpt-4o
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_ENABLED=true

AI_CB_FAILURE_THRESHOLD=3
AI_CB_COOLDOWN_SECONDS=60
AI_USER_DAILY_TOKEN_LIMIT=500000
AI_WORKSPACE_MONTHLY_TOKEN_LIMIT=10000000
